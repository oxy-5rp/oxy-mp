// Сведения о файле: версия, издатель, описание.
//
// Порождается из этого образца сборкой — см. cmake/version_info.cmake. Правьте
// образец, а не порождённое: порождённое перезаписывается при каждой настройке.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @OXYMP_VERSION_FIELDS@
PRODUCTVERSION @OXYMP_VERSION_FIELDS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE @OXYMP_FILE_TYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0419 — русский, 04b0 — Unicode. Пара обязана совпадать с Translation
        // ниже: не совпав, проводник не покажет ничего вовсе.
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "oxyMP"
            VALUE "ProductName",      "oxyMP"
            VALUE "FileDescription",  "@OXYMP_FILE_DESCRIPTION@"
            VALUE "InternalName",     "@OXYMP_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@OXYMP_ORIGINAL_FILENAME@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "oxyMP"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
