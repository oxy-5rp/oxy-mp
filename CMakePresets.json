{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "msvc-x64",
            "displayName": "MSVC x64 (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/msvc-x64",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "OXYMP_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "msvc-x64",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "msvc-x64",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "msvc-x64",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
